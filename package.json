{
  "name": "siyuan-paper-manager",
  "version": "5.0.0",
  "description": "SiYuan paper libraries backed by native databases, Zotero Connector imports, citation export, PDF metadata, and pdf2zh translation",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "vite build && node scripts/copy-assets.mjs",
    "build:prod": "vite build --mode production && node scripts/copy-assets.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "package": "pnpm run build:prod && node scripts/package.mjs && pnpm run verify:package",
    "make-link": "node scripts/make-link.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:run && pnpm run build && pnpm run verify:package"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "siyuan-plugin",
    "zotero",
    "paper",
    "pdf2zh"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.0.0",
    "archiver": "^7.0.1",
    "eslint": "^9.0.0",
    "pdfjs-dist": "^6.2.108",
    "siyuan": "^1.2.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@citation-js/core": "^0.8.2",
    "@citation-js/plugin-bibtex": "^0.8.2",
    "pinyin-pro": "3.29.3"
  }
}
